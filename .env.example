# ==============================================================================
# LissSave — Конфигурация Telegram-бота для скачивания медиа
# Скопируйте этот файл в .env и заполните обязательные параметры:
# cp .env.example .env
# ==============================================================================

# 1. Токен Telegram-бота от @BotFather (ОБЯЗАТЕЛЬНО)
BOT_TOKEN=1234567890:AAH_your_bot_token_here

# 2. Данные приложения Telegram API для локального сервера до 2 ГБ (ОБЯЗАТЕЛЬНО)
# Получить бесплатно на https://my.telegram.org (раздел API development tools)
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=0123456789abcdef0123456789abcdef

# 3. Telegram ID администраторов через запятую (для доступа к /admin)
# Узнать свой ID можно через @userinfobot
ADMIN_IDS=123456789,987654321

# 4. URL локального сервера Telegram Bot API (по умолчанию внутри Docker Compose)
LOCAL_API_URL=http://telegram-bot-api:8081

# 5. Нативная подпись под каждым отправленным видео/аудио (HTML)
AD_CAPTION=⚡️ Загружено через бота\n\n<blockquote>🔒 Стабильный доступ без ограничений — @lissvpnbot</blockquote>

# 6. Опционально: Прокси для yt-dlp (например: socks5://user:pass@ip:port или http://ip:port)
PROXY_URL=

# 7. Лимиты и пути (по умолчанию оптимальны)
MAX_CONCURRENT_DOWNLOADS=2
MAX_FILE_SIZE_MB=1950
COOKIES_FILE=data/cookies.txt
